#!/usr/bin/env bash
# Manage the add-on's background services - what `systemctl` would do, for the
# little that is needed here. See configure-services.sh for why there is no
# systemd and what a service is (an executable file in /config/services, run in
# the foreground, restarted when it exits).
set -uo pipefail

log() { printf '%s\n' "$*"; }
warn() { printf 'WARNING: %s\n' "$*" >&2; }

# shellcheck source=./configure-services.sh
source /usr/local/bin/configure-services.sh

usage() {
    cat <<'USAGE'
Usage: addon-service <command> [name]

  list                  every service, and whether it is running
  status [name]         detail for one service, or all of them
  start <name>          start it now (and keep it running)
  stop <name>           stop it until the next add-on start
  restart <name>
  logs <name> [-f]      its output; -f follows
  install <example>     copy a ready-made service into /config/services
  examples              list the ready-made ones

A service is an executable file in /config/services that runs in the
foreground. It is started when the add-on starts and restarted if it exits,
with a backoff up to a minute. Rename it to <name>.disabled to keep it without
running it.

Its output goes to /config/services/logs/<name>.log and, for services the
add-on itself started, to the Home Assistant add-on log as well.
USAGE
}

require_name() {
    [ -n "${1:-}" ] || { warn "This command needs a service name."; usage >&2; exit 2; }
    [ -f "$(service_script "$1")" ] || {
        warn "No service named '$1' in ${SERVICES_DIR}."
        warn "Existing ones: $(service_names | tr '\n' ' ')"
        exit 1
    }
}

cmd_list() {
    local name any="false"
    printf '%-24s %-10s %s\n' "SERVICE" "STATE" "PID"
    while read -r name; do
        [ -n "${name}" ] || continue
        any="true"
        if service_is_running "${name}"; then
            printf '%-24s %-10s %s\n' "${name}" "running" "$(cat "$(service_child_pidfile "${name}")" 2>/dev/null)"
        elif service_is_supervised "${name}"; then
            printf '%-24s %-10s %s\n' "${name}" "restarting" "-"
        else
            printf '%-24s %-10s %s\n' "${name}" "stopped" "-"
        fi
    done < <(service_names)

    if [ "${any}" != "true" ]; then
        echo
        echo "No services yet. ${SERVICES_DIR} is empty."
        echo "Start from a ready-made one:  addon-service examples"
    fi
}

cmd_status() {
    local name="${1:-}"
    if [ -z "${name}" ]; then
        cmd_list
        return 0
    fi
    require_name "${name}"

    local script logfile
    script="$(service_script "${name}")"
    logfile="$(service_log "${name}")"

    printf 'Service : %s\n' "${name}"
    printf 'Script  : %s%s\n' "${script}" "$([ -x "${script}" ] || printf ' (NOT EXECUTABLE - chmod +x it)')"
    printf 'Log     : %s\n' "${logfile}"
    if service_is_running "${name}"; then
        printf 'State   : running (pid %s)\n' "$(cat "$(service_child_pidfile "${name}")" 2>/dev/null)"
    elif service_is_supervised "${name}"; then
        printf 'State   : not running, being restarted\n'
    else
        printf 'State   : stopped\n'
    fi
    if [ -s "${logfile}" ]; then
        echo
        echo "Last lines of its log:"
        tail -n 10 "${logfile}" | sed 's/^/  /'
    fi
}

cmd_start() {
    require_name "${1:-}"
    local name="$1"

    if service_is_supervised "${name}"; then
        log "Service '${name}' is already running."
        return 0
    fi
    if [ ! -x "$(service_script "${name}")" ]; then
        warn "Not executable: chmod +x $(service_script "${name}")"
        exit 1
    fi

    mkdir -p "${SERVICES_LOG_DIR}" "${SERVICES_RUN_DIR}"
    rm -f "$(service_stop_flag "${name}")"
    # setsid, so the supervisor is not a child of this SSH session and does not
    # die when you log out. Its stdout is dropped rather than kept: the log file
    # is written by the supervisor itself, and a second copy of every line is
    # not useful. Services started this way therefore do not appear in the
    # add-on log, unlike those the add-on starts itself.
    setsid "$0" __supervise "${name}" >/dev/null 2>&1 &
    disown 2>/dev/null || true

    sleep 1
    if service_is_supervised "${name}"; then
        log "Started '${name}'. Its log: $(service_log "${name}")"
    else
        warn "'${name}' did not stay up. Check: addon-service logs ${name}"
        exit 1
    fi
}

cmd_stop() {
    require_name "${1:-}"
    local name="$1" pid waited=0

    if ! service_is_supervised "${name}" && ! service_is_running "${name}"; then
        log "Service '${name}' is not running."
        return 0
    fi

    # The flag first, then the signal: the supervisor checks it as soon as the
    # daemon exits, so setting it afterwards would race with a restart.
    mkdir -p "${SERVICES_RUN_DIR}"
    : > "$(service_stop_flag "${name}")"

    pid="$(cat "$(service_child_pidfile "${name}")" 2>/dev/null)"
    if [ -n "${pid}" ]; then
        kill -TERM "${pid}" 2>/dev/null || true
        while [ "${waited}" -lt 10 ] && kill -0 "${pid}" 2>/dev/null; do
            sleep 1
            waited="$((waited + 1))"
        done
        if kill -0 "${pid}" 2>/dev/null; then
            warn "'${name}' ignored SIGTERM for 10s; killing it."
            kill -KILL "${pid}" 2>/dev/null || true
        fi
    fi

    # The supervisor exits on its own once the child is gone, but if the child
    # was already dead it may be inside its backoff sleep.
    pid="$(cat "$(service_supervisor_pidfile "${name}")" 2>/dev/null)"
    if [ -n "${pid}" ]; then
        kill -TERM "${pid}" 2>/dev/null || true
    fi

    log "Stopped '${name}'. It starts again at the next add-on start, unless you"
    log "rename it to ${name}.disabled."
}

cmd_logs() {
    require_name "${1:-}"
    local logfile
    logfile="$(service_log "$1")"
    [ -e "${logfile}" ] || { log "No log yet for '$1'."; return 0; }
    if [ "${2:-}" = "-f" ]; then
        tail -n 50 -f "${logfile}"
    else
        tail -n 200 "${logfile}"
    fi
}

cmd_examples() {
    local path
    echo "Ready-made services (addon-service install <name>):"
    for path in "${SERVICES_EXAMPLE_DIR}"/*; do
        [ -f "${path}" ] || continue
        printf '  %-16s %s\n' "${path##*/}" "$(sed -n '2s/^# *//p' "${path}")"
    done
}

cmd_install() {
    local name="${1:-}" source target
    [ -n "${name}" ] || { warn "Which one? Try: addon-service examples"; exit 2; }

    source="${SERVICES_EXAMPLE_DIR}/${name}"
    target="$(service_script "${name}")"
    [ -f "${source}" ] || { warn "No ready-made service called '${name}'."; cmd_examples >&2; exit 1; }
    [ ! -e "${target}" ] || { warn "${target} already exists; not overwriting it."; exit 1; }

    mkdir -p "${SERVICES_DIR}"
    install -m 0755 "${source}" "${target}"
    log "Copied to ${target}."
    log "Read it before starting it - it says what it expects to be installed."
    log "Then: addon-service start ${name}"
}

main() {
    local command="${1:-}"
    shift || true

    case "${command}" in
        list) cmd_list ;;
        status) cmd_status "${1:-}" ;;
        start) cmd_start "${1:-}" ;;
        stop) cmd_stop "${1:-}" ;;
        restart)
            cmd_stop "${1:-}"
            cmd_start "${1:-}"
            ;;
        logs) cmd_logs "${1:-}" "${2:-}" ;;
        examples) cmd_examples ;;
        install) cmd_install "${1:-}" ;;
        # Internal: the detached supervisor process started by cmd_start.
        __supervise)
            require_name "${1:-}"
            supervise_service "$1"
            ;;
        "" | -h | --help | help) usage ;;
        *)
            warn "Unknown command: ${command}"
            usage >&2
            exit 2
            ;;
    esac
}

main "$@"
