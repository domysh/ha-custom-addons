#!/usr/bin/env bash
# systemctl for an add-on that cannot run systemd.
#
# systemd refuses to start unless it is PID 1, and this add-on shares the
# host's PID namespace so that /host and `nsenter` work - PID 1 in here is Home
# Assistant OS's own systemd, and nothing of ours can take that place. Rather
# than tell you that and stop, this reads the unit files packages install and
# runs them: install a package, `systemctl enable --now` it, and it runs, and
# comes back when the add-on restarts.
#
# See /usr/local/lib/addon-units.sh for exactly which unit directives are
# honoured and which are ignored.
#
# Note what this deliberately does NOT do: hand over to /usr/bin/systemctl when
# the systemd package happens to be installed. Packages that ship a unit file
# commonly pull systemd in for their scriptlets, so it is easy to end up with a
# real systemctl on disk - and it cannot work here for the reason above, so
# deferring to it would replace a working service manager with one that only
# ever prints "System has not been booted with systemd". The real binary is
# still there for anyone who wants it, at its own path.
set -uo pipefail

# shellcheck source=../lib/addon-units.sh
source /usr/local/lib/addon-units.sh

log() { printf '%s\n' "$*"; }
err() { printf '%s\n' "$*" >&2; }

usage() {
    cat <<'USAGE'
Usage: systemctl COMMAND [UNIT...]

  start | stop | restart | reload UNIT
  enable | disable [--now] UNIT     start it at add-on start, or stop doing so
  status [UNIT]                     state, main PID and the tail of its log
  is-active | is-enabled UNIT       for scripts; exit status carries the answer
  list-units                        every unit found, and what it is doing
  cat UNIT                          the unit file, and where it came from
  daemon-reload                     accepted and does nothing: nothing is cached

Units are read from /etc/systemd/system, /usr/local/lib/systemd/system and
/usr/lib/systemd/system, so a package's own unit file works as installed.
Enabling one links it into multi-user.target.wants, which lives on the add-on's
persistent layer, and the add-on starts everything linked there when it boots.

Logs are per unit, in /var/log/addon-units/, and also go to the Home Assistant
add-on log for units the add-on started itself.
USAGE
}

# Loads a unit, or explains why it cannot be loaded and exits.
load_unit_or_die() {
    local name file
    name="$(unit_full_name "$1")"
    if ! file="$(unit_file "${name}")"; then
        err "Unit ${name} not found in: ${UNIT_PATHS[*]}"
        exit 4
    fi
    if ! unit_parse "${name}" "${file}"; then
        err "Unit ${name} has no ExecStart; only services that run a command are supported."
        exit 5
    fi
    UNIT_NAME="${name}"
    UNIT_FILE="${file}"
}

cmd_start() {
    load_unit_or_die "$1"

    if unit_is_supervised "${UNIT_NAME}"; then
        log "${UNIT_NAME} is already running."
        return 0
    fi

    mkdir -p "$(unit_state_dir "${UNIT_NAME}")" "${UNIT_LOG_DIR}"
    rm -f "$(unit_stop_flag "${UNIT_NAME}")"

    # setsid, so the service is not a child of this SSH session and does not
    # die when you log out.
    setsid "$0" __supervise "${UNIT_NAME}" >/dev/null 2>&1 &
    disown 2>/dev/null || true

    local waited=0
    while [ "${waited}" -lt 5 ]; do
        sleep 1
        waited=$((waited + 1))
        if unit_is_active "${UNIT_NAME}"; then
            log "Started ${UNIT_NAME} (pid $(unit_main_pid "${UNIT_NAME}"))."
            return 0
        fi
        unit_is_supervised "${UNIT_NAME}" || break
    done

    if [ "${U_TYPE}" = "oneshot" ]; then
        log "Ran ${UNIT_NAME} (Type=oneshot)."
        return 0
    fi

    err "${UNIT_NAME} did not stay running. Its log:"
    tail -n 15 "$(unit_log_file "${UNIT_NAME}")" 2>/dev/null | sed 's/^/  /' >&2
    exit 1
}

cmd_stop() {
    load_unit_or_die "$1"
    local pid waited=0

    if ! unit_is_supervised "${UNIT_NAME}" && ! unit_is_active "${UNIT_NAME}"; then
        log "${UNIT_NAME} is not running."
        return 0
    fi

    # The flag before the signal: the supervisor checks it the moment the
    # process exits, so setting it afterwards would race with a restart.
    mkdir -p "$(unit_state_dir "${UNIT_NAME}")"
    : > "$(unit_stop_flag "${UNIT_NAME}")"

    if [ -n "${U_EXECSTOP}" ]; then
        unit_run_command "${U_EXECSTOP}" >> "$(unit_log_file "${UNIT_NAME}")" 2>&1 || true
    fi

    pid="$(unit_main_pid "${UNIT_NAME}")"
    if [ -n "${pid}" ]; then
        # The whole process group, not just the main process: systemd stops a
        # unit's entire cgroup, and a daemon that forked helpers would
        # otherwise leave them behind, orphaned and still holding its port. The
        # supervisor runs each service in a process group of its own precisely
        # so this can be done, and the fallback covers the case where the group
        # is gone but the process is not.
        kill -TERM -- "-${pid}" 2>/dev/null || kill -TERM "${pid}" 2>/dev/null || true
        while [ "${waited}" -lt "${U_TIMEOUTSTOP}" ] && kill -0 "${pid}" 2>/dev/null; do
            sleep 1
            waited=$((waited + 1))
        done
        if kill -0 "${pid}" 2>/dev/null; then
            err "${UNIT_NAME} ignored SIGTERM for ${U_TIMEOUTSTOP}s; killing it."
            kill -KILL -- "-${pid}" 2>/dev/null || kill -KILL "${pid}" 2>/dev/null || true
        fi
    fi

    pid="$(cat "$(unit_supervisor_pidfile "${UNIT_NAME}")" 2>/dev/null)"
    if [ -n "${pid}" ]; then
        kill -TERM "${pid}" 2>/dev/null || true
    fi

    log "Stopped ${UNIT_NAME}."
}

cmd_reload() {
    load_unit_or_die "$1"
    if [ -z "${U_EXECRELOAD}" ]; then
        err "${UNIT_NAME} has no ExecReload; use 'systemctl restart ${UNIT_NAME}'."
        exit 1
    fi
    unit_run_command "${U_EXECRELOAD}" && log "Reloaded ${UNIT_NAME}."
}

cmd_enable() {
    local now="false" name
    [ "$1" = "--now" ] && { now="true"; shift; }
    load_unit_or_die "$1"
    name="${UNIT_NAME}"

    mkdir -p "${UNIT_WANTS_DIR}"
    ln -sfn "${UNIT_FILE}" "${UNIT_WANTS_DIR}/${name}"
    log "Created ${UNIT_WANTS_DIR}/${name} -> ${UNIT_FILE}"
    log "${name} will start when the add-on starts."
    [ "${now}" = "true" ] && cmd_start "${name}"
    return 0
}

cmd_disable() {
    local now="false" name
    [ "$1" = "--now" ] && { now="true"; shift; }
    name="$(unit_full_name "$1")"

    if [ -L "${UNIT_WANTS_DIR}/${name}" ]; then
        rm -f "${UNIT_WANTS_DIR}/${name}"
        log "Removed ${UNIT_WANTS_DIR}/${name}."
    else
        log "${name} was not enabled."
    fi
    [ "${now}" = "true" ] && cmd_stop "${name}"
    return 0
}

unit_state_word() {
    local name="$1"
    if unit_is_active "${name}"; then printf 'active'
    elif unit_is_supervised "${name}"; then printf 'activating'
    else printf 'inactive'; fi
}

cmd_status() {
    local name
    if [ -z "${1:-}" ]; then
        cmd_list_units
        return 0
    fi
    load_unit_or_die "$1"
    name="${UNIT_NAME}"

    printf '%s - %s\n' "${name}" "${U_DESCRIPTION:-no description}"
    printf '   Loaded: %s (%s)\n' "${UNIT_FILE}" \
        "$(unit_is_enabled "${name}" && printf 'enabled' || printf 'disabled')"
    printf '   Active: %s' "$(unit_state_word "${name}")"
    if unit_is_active "${name}"; then
        printf ' (main pid %s)' "$(unit_main_pid "${name}")"
    fi
    printf '\n'
    printf '     Type: %s   Restart: %s\n' "${U_TYPE}" "${U_RESTART}"
    printf '      Log: %s\n' "$(unit_log_file "${name}")"

    if [ -s "$(unit_log_file "${name}")" ]; then
        printf '\n'
        tail -n 12 "$(unit_log_file "${name}")" | sed 's/^/   /'
    fi
}

cmd_list_units() {
    local dir file name seen=" "
    printf '%-40s %-11s %-9s %s\n' "UNIT" "STATE" "ENABLED" "FILE"
    for dir in "${UNIT_PATHS[@]}"; do
        [ -d "${dir}" ] || continue
        for file in "${dir}"/*.service; do
            [ -e "${file}" ] || continue
            name="${file##*/}"
            case "${seen}" in *" ${name} "*) continue ;; esac
            seen="${seen}${name} "
            printf '%-40s %-11s %-9s %s\n' "${name}" "$(unit_state_word "${name}")" \
                "$(unit_is_enabled "${name}" && printf 'enabled' || printf 'disabled')" "${file}"
        done
    done
}

main() {
    local command="${1:-}"
    shift || true
    # Flags systemctl users pass out of habit; harmless here, and refusing them
    # would break scripts that call `systemctl --no-pager status`.
    local args=()
    for a in "$@"; do
        case "${a}" in
            --no-pager | --no-ask-password | -q | --quiet | --system) ;;
            *) args+=("${a}") ;;
        esac
    done
    set -- ${args[@]+"${args[@]}"}

    case "${command}" in
        start) [ $# -ge 1 ] || { err "start needs a unit"; exit 2; }; for u in "$@"; do cmd_start "${u}"; done ;;
        stop) [ $# -ge 1 ] || { err "stop needs a unit"; exit 2; }; for u in "$@"; do cmd_stop "${u}"; done ;;
        restart | try-restart)
            [ $# -ge 1 ] || { err "restart needs a unit"; exit 2; }
            for u in "$@"; do cmd_stop "${u}"; cmd_start "${u}"; done
            ;;
        reload) cmd_reload "${1:-}" ;;
        reload-or-restart) cmd_reload "${1:-}" 2>/dev/null || { cmd_stop "${1:-}"; cmd_start "${1:-}"; } ;;
        enable) [ $# -ge 1 ] || { err "enable needs a unit"; exit 2; }; cmd_enable "$@" ;;
        disable) [ $# -ge 1 ] || { err "disable needs a unit"; exit 2; }; cmd_disable "$@" ;;
        status) cmd_status "${1:-}" ;;
        is-active)
            load_unit_or_die "${1:-}"
            printf '%s\n' "$(unit_state_word "${UNIT_NAME}")"
            unit_is_active "${UNIT_NAME}"
            ;;
        is-enabled)
            local name; name="$(unit_full_name "${1:-}")"
            unit_is_enabled "${name}" && { echo enabled; exit 0; }
            echo disabled; exit 1
            ;;
        list-units | list-unit-files) cmd_list_units ;;
        cat)
            load_unit_or_die "${1:-}"
            printf '# %s\n' "${UNIT_FILE}"
            cat "${UNIT_FILE}"
            ;;
        --version | version)
            # Installers parse this. kardianos/service - which netbird and
            # others use to install themselves - runs `systemctl --version` and
            # matches /systemd ([0-9]+)/ to decide which unit-file features it
            # may use; without a parseable answer it assumes the worst.
            # The number is a compatibility claim, not a fact, so the line says
            # what this actually is right after it.
            echo "systemd 245 (addon-units: a replacement, not systemd)"
            ;;
        daemon-reload | daemon-reexec | preset)
            # Nothing is cached, so there is nothing to reload. Reported as
            # success because installers - `netbird service install` among
            # them - call it and stop on a non-zero status.
            ;;
        # Internal: the detached supervisor started by cmd_start.
        __supervise)
            load_unit_or_die "${1:-}"
            unit_supervise "${UNIT_NAME}"
            ;;
        "" | -h | --help | help) usage ;;
        *)
            err "systemctl: '${command}' is not supported by this replacement."
            err "Run 'systemctl --help' for what is."
            exit 3
            ;;
    esac
}

main "$@"
