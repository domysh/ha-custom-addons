#!/usr/bin/env bash
# tailscaled - joins this machine to your tailnet.
#
# Install tailscale first, from the shell:
#
#     dnf install -y tailscale
#
# and if your Fedora release does not carry it:
#
#     dnf config-manager addrepo --from-repofile=https://pkgs.tailscale.com/stable/fedora/tailscale.repo
#     dnf install -y tailscale
#
# The install is persistent, so this is a one-time step (see the add-on docs).
# Do NOT enable the systemd unit the package ships - there is no systemd here,
# which is what this file replaces. Then:
#
#     addon-service start tailscaled
#     tailscale up          # once, interactive: it prints a login URL
#     tailscale status
#
# READ THIS BEFORE STARTING IT. The add-on runs in the HOST's network
# namespace, so the tailscale0 interface is created on Home Assistant OS
# itself, not just in this container: the whole machine joins your tailnet, and
# it stays joined for as long as this service runs. That is usually the point -
# it is how you reach Home Assistant from outside - but it also means:
#   - it will collide with any other tailscale on this host, including the
#     official Tailscale add-on. Run one or the other, not both.
#   - `tailscale up --advertise-routes=...` advertises the host's networks, and
#     --advertise-exit-node makes the host an exit node.
# The state, and therefore the node identity, is kept on a mapped path, so
# updating the add-on does not create a new node in your tailnet each time.
set -euo pipefail

STATE_DIR="/config/tailscale"
SOCKET_DIR="/run/tailscale"

mkdir -p "${STATE_DIR}" "${SOCKET_DIR}"

args=(
    --state="${STATE_DIR}/tailscaled.state"
    --statedir="${STATE_DIR}"
    --socket="${SOCKET_DIR}/tailscaled.sock"
)

if [ ! -c /dev/net/tun ]; then
    # The add-on creates this node at start-up; if it is still missing, that
    # means it could not (Protection mode on, or no tun module on the host).
    # Userspace networking keeps tailscaled usable for outbound connections
    # through its SOCKS proxy, but it creates no interface: nothing on the
    # tailnet can reach this machine, and `tailscale ip` addresses will not
    # respond. Better than refusing to start, but say so plainly in the log.
    echo "WARNING: /dev/net/tun is missing - falling back to userspace networking."
    echo "WARNING: This host will NOT be reachable over the tailnet; only outbound"
    echo "WARNING: connections through the SOCKS5 proxy on localhost:1055 work."
    args+=(--tun=userspace-networking --socks5-server=localhost:1055)
fi

# exec, so the supervisor watches tailscaled itself and its signals reach it.
exec /usr/sbin/tailscaled "${args[@]}"
